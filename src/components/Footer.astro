---
import { Mail } from "@lucide/astro";
import Linkedin from "./icons/Linkedin.astro";
import Instagram from "./icons/Instagram.astro";
import Leetcode from "./icons/Leetcode.astro";
import { siteConfig } from "../site.config";

const year = new Date().getFullYear();
// GitHub lives in the nav instead (next to the theme toggle), so it's
// excluded here to avoid showing the same link twice.
const socialLinks = Object.entries(siteConfig.social).filter(([platform, url]) => url && platform !== "github");

const icons = {
  linkedin: Linkedin,
  instagram: Instagram,
  leetcode: Leetcode,
  email: Mail,
} as const;

const labels: Record<keyof typeof icons, string> = {
  linkedin: "LinkedIn",
  instagram: "Instagram",
  leetcode: "LeetCode",
  email: "Email",
};
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:justify-between">
    <p class="text-sm text-fg-muted">
      &copy; {year} {siteConfig.name}. Built with <a
        href="https://github.com/prjvvl/trestle"
        class="hover:text-fg underline underline-offset-2"
        rel="noopener noreferrer"
        target="_blank"
      >Trestle</a>.
    </p>

    {
      socialLinks.length > 0 && (
        <div class="flex gap-4">
          {socialLinks.map(([platform, url]) => {
            const key = platform as keyof typeof icons;
            const Icon = icons[key];
            const isEmail = key === "email";
            return (
              <a
                href={url}
                class="text-fg-muted hover:text-fg"
                aria-label={labels[key]}
                title={labels[key]}
                rel={isEmail ? undefined : "me noopener noreferrer"}
                target={isEmail ? undefined : "_blank"}
              >
                <Icon class="size-5" aria-hidden="true" />
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</footer>
