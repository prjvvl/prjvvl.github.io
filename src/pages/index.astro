---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import { siteConfig } from "../site.config";
import { projects } from "../data/projects";

const featured = projects.filter((project) => project.featured);
---

<BaseLayout title={siteConfig.name}>
  <Hero title="Hi, I'm Prajwal" subtitle={siteConfig.description} typewriter>
    <Button href="/projects">View projects</Button>
    <Button href="/blog" variant="secondary">Read the blog</Button>
  </Hero>

  <section class="mx-auto max-w-5xl px-4 pb-20">
    <h2 class="text-lg font-semibold text-fg">Featured</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {
        featured.map((project) => {
          const Icon = project.icon;
          return (
            <Card title={project.title} description={project.description} href={project.href}>
              <Icon slot="icon" class="size-5 text-brand" aria-hidden="true" />
            </Card>
          );
        })
      }
    </div>
    <div class="mt-8">
      <Button href="/projects" variant="secondary">See all projects</Button>
    </div>
  </section>
</BaseLayout>
